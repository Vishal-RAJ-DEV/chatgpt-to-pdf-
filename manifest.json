{
  "manifest_version": 3,
  "name": "ChatGPT PDF Exporter",
  "version": "0.1.0",
  "description": "Export ChatGPT conversations as clean, professionally formatted PDFs locally and securely.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Export ChatGPT to PDF",
    "default_popup": "src/ui/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/ui/options/options.html",
  "minimum_chrome_version": "110"
}

